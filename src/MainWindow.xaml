<Window x:Class="DshLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DshLauncher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="DeepSeek Harness"
        Icon="pack://application:,,,/DshLauncher;component/DshLauncher.ico"
        Height="700" Width="1020"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        BorderThickness="1"
        BorderBrush="#30363D"
        Background="#141517">

    <!-- 沉浸式现代暗黑顶栏：支持窗口边缘无死角缩放与顶部拖拽 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- 现代暗黑输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E2023"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#2D72F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代胶囊按钮 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B22"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 交通灯 / 极简窗口控制按钮 -->
        <Style x:Key="WindowActionButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#F0F6FC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮悬浮红光 -->
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowActionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ── 下拉框（暗色）：默认 Aero 样式在这个窗口里会亮成一块白 ── -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2D333B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2D72F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#22272E" BorderBrush="#30363D"
                                                BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="7,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem,
                                                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <TextBlock Grid.Column="1" Text="▾" Foreground="#8B949E"
                                                           FontSize="9" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A525C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#1E2023" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,0,0" MaxHeight="320"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/> <!-- Modern Two-Row Header Layout -->
            <RowDefinition Height="*"/>   <!-- Center Web View -->
            <RowDefinition Height="Auto"/> <!-- Splitter -->
            <RowDefinition x:Name="RowConsole" Height="160" MinHeight="80"/> <!-- Console Log Panel -->
            <RowDefinition Height="24"/> <!-- Micro Telemetry Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar (Two Rows: Row 1 = Title + Captions, Row 2 = Params & Actions) -->
        <Border Grid.Row="0" Background="#18191B" BorderBrush="#26282B" BorderThickness="0,0,0,1" Padding="14,0,0,0">
            <Grid WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/> <!-- Row 1: Brand & Window Control -->
                    <RowDefinition Height="38"/> <!-- Row 2: Controls & Action Buttons -->
                </Grid.RowDefinitions>

                <!-- Row 1 Left: Brand Logo & Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 应用内标识：直接用应用图标本身，保证与任务栏/资源管理器里看到的一致 -->
                    <Image Source="pack://application:,,,/DshLauncher;component/DshLauncher.ico" Width="18" Height="18"
                           Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="deepseek" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                    <Border Background="#22272E" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HARNESS" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E"/>
                    </Border>
                    <TextBlock Text="控制中心" FontSize="12" Foreground="#8B949E" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Row 1 Right: Window Caption Buttons (Min/Max/Close) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource WindowActionButtonStyle}" Click="BtnMinimize_Click" ToolTip="最小化">
                        <TextBlock Text="─" FontSize="11" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource WindowActionButtonStyle}" Click="BtnMaximize_Click" ToolTip="最大化 / 还原">
                        <TextBlock x:Name="TxtMaxIcon" Text="□" FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButtonStyle}" Click="BtnClose_Click" ToolTip="关闭">
                        <TextBlock Text="✕" FontSize="11" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Row 2: Controls, Params & Action Buttons (Spacious Layout) -->
                <DockPanel Grid.Row="1" LastChildFill="False" VerticalAlignment="Center" Margin="0,0,14,0">
                    <!-- Left: Parameters & Execution -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="参数:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                        <TextBox x:Name="TxtArgs" Width="70" Text="web" Margin="0,0,10,0"/>

                        <TextBlock Text="端口:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                        <TextBox x:Name="TxtPort" Width="50" Text="3080" Margin="0,0,12,0"/>

                        <CheckBox x:Name="ChkAutoOpenBrowser" Content="自动加载" IsChecked="True" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                        <CheckBox x:Name="ChkAutoRestart" Content="崩溃重启" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"/>

                        <!-- 启动选项：决定「以什么身份、带不带控制台窗口」启动 -->
                        <TextBlock Text="权限:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                        <ComboBox x:Name="CmbPrivilege" Width="86" Height="24" Margin="0,0,10,0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CmbPrivilege_SelectionChanged"
                                  ToolTip="以什么身份启动 DSH">
                            <ComboBoxItem Content="普通" Tag="Normal"/>
                            <ComboBoxItem Content="管理员" Tag="Administrator"/>
                            <ComboBoxItem Content="SYSTEM" Tag="System"/>
                        </ComboBox>

                        <CheckBox x:Name="ChkHideConsole" Content="隐藏控制台" IsChecked="True" Foreground="#C9D1D9"
                                  VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"
                                  Checked="ChkHideConsole_Changed" Unchecked="ChkHideConsole_Changed"
                                  ToolTip="不显示 DSH 子进程的控制台窗口。取消勾选会开一个真实窗口 —— 提权 / SYSTEM 模式下那是唯一能直接看到 node 原始输出的方式"/>

                        <!-- Primary Start Button (DeepSeek Accent Blue) -->
                        <Button x:Name="BtnStart" Content="启动" Background="#2D72F6" Foreground="#FFFFFF" BorderBrush="#2D72F6" Width="60" Height="26" Margin="0,0,6,0" Click="BtnStart_Click"/>
                        <Button x:Name="BtnStop" Content="停止" Width="60" Height="26" IsEnabled="False" Margin="0,0,8,0" Click="BtnStop_Click"/>
                    </StackPanel>

                    <!-- Right: Tool Actions -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="TglShowLog" Content="📋 日志" IsChecked="True" Margin="0,0,6,0"
                                      Click="TglShowLog_Click"
                                      ToolTip="显示 / 隐藏底部控制台面板（收起后浏览器占满可用空间）"/>
                        <Button x:Name="BtnSessions" Content="🗂 会话" Margin="0,0,6,0" Click="BtnSessions_Click" ToolTip="会话管理：清点 / 逐回合核对 / 归档 / 隔离可回滚"/>
                        <Button x:Name="BtnRescue" Content="🛟 救援" Margin="0,0,6,0" Click="BtnRescue_Click" ToolTip="DSH 救援：快照体检 / 刷新快照 / 修复会话 / 试用救援包（机器上的 DSH 装坏了也能修日志）"/>
                        <Button x:Name="BtnSettings" Content="⚙ 设置" Margin="0,0,6,0" Click="BtnSettings_Click"/>
                        <Button x:Name="BtnRefreshWeb" Content="🔄 刷新" Margin="0,0,6,0" Click="BtnRefreshWeb_Click"/>
                        <Button x:Name="BtnQuickWeb" Content="🌐 浏览器打开" Margin="0,0,6,0" Click="BtnQuickWeb_Click"/>
                        <Button x:Name="BtnOpenProfile" Content="📁 配置目录" Click="BtnOpenProfile_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 2. Center: Modern Embedded Chromium Workspace (WebView2) + 右侧可收起救援侧栏 -->
        <Grid Grid.Row="1" Background="#141517">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>   <!-- 内嵌工作区 -->
                <ColumnDefinition Width="Auto"/>               <!-- 侧栏分隔条（收起时随侧栏一起隐藏） -->
                <ColumnDefinition x:Name="RescueSidebarColumn" Width="0"/> <!-- 救援侧栏（展开时 440，可拖动） -->
            </Grid.ColumnDefinitions>

            <!-- 2a. 工作区：WebView2 + 空状态引导 -->
            <Grid x:Name="WebHost" Grid.Column="0" Background="#141517">
                <!-- Embedded WebView2 (Chromium / Edge) Control -->
                <wv2:WebView2 x:Name="MainWebView" Visibility="Collapsed" DefaultBackgroundColor="#141517"/>

                <!-- Elegant Dark Empty State / Ready Guide -->
                <Border x:Name="PnlEmptyState" Background="#141517" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🚀" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="DeepSeek Harness 就绪" FontSize="16" FontWeight="SemiBold" Foreground="#E6EDF3" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="点击上方 [启动] 按钮开启 DSH 服务，认证就绪后将自动加载工作区" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="立即启动 DSH" Background="#2D72F6" Foreground="#FFFFFF" BorderBrush="#2D72F6" Padding="14,6" FontSize="13" FontWeight="Medium" Click="BtnStart_Click" Margin="0,0,10,0"/>
                            <Button Content="⚙ 路径与配置设置" Padding="12,6" FontSize="13" Click="BtnSettings_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2b. 侧栏分隔条：4px，拖动即改侧栏宽度（收起时一并隐藏） -->
            <GridSplitter x:Name="RescueSplitter" Grid.Column="1" Width="4" Height="Auto"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#26282B" Cursor="SizeWE" Visibility="Collapsed"/>

            <!-- 2c. 救援侧栏宿主：宽度由 RescueSidebarColumn 决定（可被上面的分隔条拖动） -->
            <Border x:Name="RescueSidebarHost" Grid.Column="2"
                    Background="#141517" BorderBrush="#26282B" BorderThickness="1,0,0,0"
                    MinWidth="260" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 侧栏标题行 -->
                        <RowDefinition Height="*"/>      <!-- 救援面板本体 -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#18191B" BorderBrush="#26282B" BorderThickness="0,0,0,1" Padding="12,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="🛟 DSH 救援" FontSize="12.5" FontWeight="Bold"
                                       Foreground="#F0F6FC" VerticalAlignment="Center"/>

                            <Button Grid.Row="0" Style="{StaticResource WindowActionButtonStyle}"
                                    Width="34" Height="30" HorizontalAlignment="Right"
                                    Click="BtnRescueCollapse_Click" ToolTip="收起救援侧栏（✕）">
                                <TextBlock Text="✕" FontSize="11" VerticalAlignment="Center"/>
                            </Button>

                            <TextBlock Grid.Row="1" Text="快照的是代码 · 修复的是日志 · 一切如实报告"
                                       FontSize="10.5" Foreground="#6E7681" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <local:RescuePanel Grid.Row="1" x:Name="RescueSidebar"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Hairline Splitter -->
        <GridSplitter x:Name="ConsoleSplitter" Grid.Row="2" Height="2" HorizontalAlignment="Stretch" Background="#26282B" Cursor="SizeNS"/>

        <!-- 4. Bottom: Dark Terminal Console Log -->
        <Grid x:Name="ConsolePanel" Grid.Row="3" Background="#141517">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Console Header -->
            <Border Grid.Row="0" Background="#18191B" Padding="12,0" BorderBrush="#26282B" BorderThickness="0,0,0,1">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="控制台" Foreground="#C9D1D9" FontWeight="SemiBold" FontSize="11"/>
                        <Border x:Name="BadgeStatus" Background="#30363D" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                            <TextBlock x:Name="TxtStatusBadge" Text="已停止" FontSize="10" Foreground="#8B949E"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkAutoScroll" Content="自动滚动" IsChecked="True" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                        <Button x:Name="BtnClearLog" Content="清屏" Padding="8,1" Height="20" Margin="0,0,4,0" FontSize="11" Click="BtnClearLog_Click"/>
                        <Button x:Name="BtnCopyLog" Content="复制" Padding="8,1" Height="20" Margin="0,0,4,0" FontSize="11" Click="BtnCopyLog_Click"/>
                        <Button x:Name="BtnCollapseLog" Content="⯆ 隐藏" Padding="8,1" Height="20" FontSize="11"
                                Click="BtnCollapseLog_Click" ToolTip="收起日志面板，把空间让给浏览器（工具栏「📋 日志」可随时恢复）"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Monospace Log Stream -->
            <TextBox Grid.Row="1"
                     x:Name="TxtLogs"
                     Background="#141517"
                     Foreground="#E6EDF3"
                     FontFamily="Cascadia Code, JetBrains Mono, Consolas, Courier New"
                     FontSize="12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Padding="12,6"/>
        </Grid>

        <!-- 5. Micro Telemetry Footer -->
        <Border Grid.Row="4" Background="#141517" BorderBrush="#26282B" BorderThickness="0,1,0,0" Padding="12,0">
            <TextBlock x:Name="TxtFooterInfo" Text="就绪 · DSH Runtime: Ready" Foreground="#6E7681" FontSize="11" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas"/>
        </Border>
    </Grid>
</Window>
